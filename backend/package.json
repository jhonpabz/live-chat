{
  "name": "live-chat-backend",
  "version": "1.0.0",
  "description": "Live Chat Customer Support Backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --watch server.ts --ext ts --exec \"npm run build && node dist/server.js\"",
    "db:migrate": "node dist/scripts/migrate.js",
    "admin:bootstrap": "node dist/scripts/bootstrap-admin.js",
    "test": "npm run build && node --test test/*.test.js",
    "test:postgres": "npm run build && node dist/scripts/test-postgres.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "redis": "^4.6.14",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.4",
    "typescript": "5.9"
  }
}
